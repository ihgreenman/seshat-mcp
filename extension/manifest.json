{
  "manifest_version": 3,
  "name": "seshat capture",
  "version": "0.8.0",
  "description": "Write a note about the page you are reading, with the page attached as evidence.",
  "homepage_url": "https://github.com/ihgreenman/seshat-mcp",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture to seshat"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
